{
  "name": "nothing-terminal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A Nothing-inspired Linux terminal emulator built with Tauri, Rust, React, TypeScript, xterm.js, and portable-pty.",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420",
    "build": "tsc && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 1421",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.0.4",
    "typescript": "^5",
    "vite": "8.1.5"
  }
}
