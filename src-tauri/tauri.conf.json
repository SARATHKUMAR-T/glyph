{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Glyph",
  "version": "0.1.0",
  "identifier": "com.aximsoft.glyph",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Glyph",
        "width": 1180,
        "height": 760,
        "minWidth": 400,
        "minHeight": 160,
        "decorations": false,
        "resizable": true,
        "center": true,
        "backgroundColor": "#040406"
      }
    ],
    "security": {
      "capabilities": ["main"],
      "csp": "default-src 'self' tauri: ipc: http://ipc.localhost; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: https://asset.localhost tauri: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost tauri: https://ryycxbwdwtyqvqsgtnwb.supabase.co https:; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "category": "DeveloperTool"
  }
}
